# HarnessLoop / 驭环 —— LLM 连接配置
# 用法：复制为 .env（仓库根目录或 profile 所在目录），填入真实值。
# .env 已被 .gitignore 忽略，且不会写入 runs/ 目录或报告中。

# 模型名（不带 provider 前缀时自动拼接 provider）
HARNESSLOOP_MODEL=gpt-4o-mini

# provider（可选）：openai / anthropic / deepseek / azure / openrouter / ollama 等
# 留空则要求 HARNESSLOOP_MODEL 自带前缀，例如 openai/gpt-4o-mini
HARNESSLOOP_PROVIDER=openai

# API 地址（OpenAI 兼容网关 / 自建代理 / 本地推理服务）
HARNESSLOOP_API_BASE=https://api.openai.com/v1

# API Key（必填，除非使用本地无鉴权服务）
HARNESSLOOP_API_KEY=sk-your-key-here

# 采样温度（默认 0.0，评测场景建议保持 0）
HARNESSLOOP_TEMPERATURE=0.0
